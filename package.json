{
  "name": "pix8",
  "version": "1.14.0",
  "description": "256-color indexed pixel art editor",
  "main": "electron-main.js",
  "bin": {
    "pix8": "tools/pix8.mjs"
  },
  "author": {
    "name": "Dynart",
    "email": "info@dynart.net",
    "url": "https://dynart.net"
  },
  "scripts": {
    "start": "npx serve .",
    "build": "webpack",
    "dev": "webpack --mode development --watch",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "build:www": "node tools/build-www.mjs",
    "cap:sync": "npm run build && npm run build:www && cap sync android",
    "android": "npm run cap:sync && cap open android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "build": {
    "appId": "net.dynart.pix8",
    "productName": "Pix8",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "index.html",
      "dist/**/*",
      "js/**/*",
      "css/**/*",
      "images/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "serve": "^14.2.6",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "jszip": "^3.10.1"
  }
}
